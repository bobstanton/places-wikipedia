{
  "name": "places-wikipedia",
  "version": "0.0.2",
  "description": "Query nearby Wikipedia articles with VaultQuery and display them in Places.",
  "main": "main.js",
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "npm run typecheck && npm run bundle",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck",
    "lint": "eslint src package.json manifest.json versions.json",
    "bundle": "node esbuild.config.mjs production",
    "watch": "node esbuild.config.mjs watch",
    "format": "node ../../vaultquery-tests/scripts/lint.mjs --format-only --repo . --fix",
    "format:check": "node ../../vaultquery-tests/scripts/lint.mjs --format-only --repo ."
  },
  "overrides": {
    "typescript": "6.0.3",
    "obsidian": "1.14.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^2.1.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vaultquery": "git+https://github.com/bobstanton/vaultquery.git#1.2.3"
  },
  "dependencies": {
    "places-shared": "git+https://github.com/bobstanton/places-shared.git#0.0.2"
  }
}
